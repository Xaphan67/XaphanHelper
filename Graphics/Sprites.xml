    <Anim id="XaphanHelper_turnAround" path="player/turnaround" frames="0-3" delay="0.08"/>
    <Anim id="XaphanHelper_turnAround_reverse" path="player/turnaround" frames="3-0" delay="0.08"/>
    <Loop id="XaphanHelper_turnAround_end" path="player/turnaround" frames="3" delay = "0"/>
