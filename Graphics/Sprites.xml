    <Loop id="hairBackpack" path="player/spinJumpHair" delay="0.04"/>
    <Loop id="hairNoBackpack" path="player_no_backpack/spinJumpHair" delay="0.04"/>
  </XaphanHelper_player_spinJump>

  # The animation here will populate the vanilla "player" etc
