    <Anim id="jumpLookDown" path="jump_lookDown" delay="0.1" frames="0,1" />
    <Loop id="jumpAim" path="jump_aim" delay="0.1" frames="0,1" />
    <Anim id="fallSlow" path="jumpSlow" delay="0.1" frames="2,3" />
